<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Storage permissions -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <!-- Unrestricted file access for this personal sideloaded app -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!-- Playback / service permissions -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Lets Settings -> Diagnostics offer the "exempt from battery optimization" system prompt —
         some OEM skins throttle/delay the widget-update broadcast and background playback while
         the app isn't foregrounded unless the user grants this. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Post notifications (API 33+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Network access for AI synopsis and update checks -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Side-load APK updates -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!--
      largeHeap: ExoPlayer's Mp4Extractor materialises a whole MP4's sample table on the Java heap
      (~24 bytes/sample). Long single-file audiobooks are enormous: a 48 h m4b with 7.5M AAC frames
      needs ~172 MB of arrays, which OOMs at the default ~192-256 MB heap. This buys headroom for
      mid-large files and pre-API-30 devices; files far past that (261 h / 22M samples, ~505 MB)
      are instead routed around Mp4Extractor entirely on API 30+ — see
      playback/LargeFileMediaSourceFactory.
    -->
    <application
        android:name=".VoyageApp"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher_vee"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:roundIcon="@mipmap/ic_launcher_vee_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Voyage">

        <!-- exported="true" with no MAIN/LAUNCHER filter of its own: the launcher entry point
             lives on the activity-aliases below (see AppIconManager) so the icon can be switched
             without ever touching this component. Stays exported because it's still started
             directly by explicit component intents that don't go through the launcher at all —
             pinned book shortcuts (util/BookShortcuts.kt), the widget's PendingIntents
             (widget/WidgetIntents.kt), and WidgetConfigureActivity. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize">
            <!-- Companion pack ingest (docs/companion-packs.md §10.3, P4): a `.voyagepack` shared
                 from Gmail/Drive/Telegram/etc. arrives as ACTION_SEND with an opaque content:// URI
                 and, per §10.3 step 1, usually application/octet-stream rather than a recognised
                 pack MIME type — filtering only on a `.voyagepack` extension pattern would miss
                 most real deliveries, so this filters broadly and CompanionImportService sniffs the
                 archive for manifest.json/pack.json after ingest, rejecting quietly if absent. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/zip" />
            </intent-filter>
            <!-- A file manager / "open with" tap on a .voyagepack delivers ACTION_VIEW instead. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" android:host="*" android:pathPattern=".*\\.voyagepack" />
            </intent-filter>
        </activity>

        <!-- Custom app icon picker (Settings -> Theme -> App icon, see util/AppIconManager.kt).
             Exactly one of these six is ever enabled at a time; all target the same MainActivity,
             so switching icons never creates a second Activity instance or back-stack entry.
