        <!-- Media3 playback service -->
        <!-- stopWithTask=false is already the platform default, but stating it explicitly is
             what some OEM skins actually read when deciding whether to tear the service down
             along with a swiped-away task. Keeping playback alive across that swipe is handled
             in PlaybackService.onTaskRemoved; this is belt-and-braces for the same goal. -->
        <service
            android:name=".playback.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback"
            android:stopWithTask="false">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
                <action android:name="androidx.media3.session.MediaLibraryService" />
            </intent-filter>
        </service>

        <!-- Home screen widget: freeform "Custom" provider (opens the in-app designer via
             WidgetConfigureActivity) plus two fixed-design providers below, each its own
             launcher-picker entry with a real preview and no configure step — placing either
             auto-binds to its seeded design (see DefaultWidgetDesigns/WidgetUpdater). All
             rendering/click-handling is driven by WidgetUpdater (no ACTION_UPDATE_WIDGET
             broadcast — see widget/WidgetUpdater.kt). -->
        <receiver
            android:name=".widget.VoyageWidgetProvider"
            android:exported="true"
            android:label="@string/widget_label_custom">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info" />
        </receiver>

